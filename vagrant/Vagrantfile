# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|

  # =========================================================================
  # GLOBAL SETTINGS
  # =========================================================================

  config.vm.box_check_update = false
  config.vm.boot_timeout = 900  # 15 minutes for slower machines

  # Disable guest additions version check (intentionally using old vulnerable box)
  if Vagrant.has_plugin?("vagrant-vbguest")
    config.vbguest.auto_update = false
  end

  # Generate random suffix to prevent VM name conflicts
  random_suffix = rand(100000..999999)

  # =========================================================================
  # KALI LINUX VM (Attacker)
  # =========================================================================

  config.vm.define "kali" do |kali|
    kali.vm.box = "kalilinux/rolling"
    kali.vm.hostname = "kali-attacker"

    # SSH settings - Kali can be slow to boot
    kali.ssh.insert_key = true
    kali.ssh.forward_agent = false
    kali.ssh.connect_timeout = 600  # 10 minutes (increased for package upgrades)
    kali.ssh.keep_alive = true
    kali.vm.boot_timeout = 900  # 15 minutes for Kali

    # Network - host-only network for VM-to-VM communication
    # NAT adapter (eth0/adapter 1) is added automatically by Vagrant for management
    # Host-only adapter (eth1/adapter 2) is for exploit traffic
    kali.vm.network "private_network",
      ip: "192.168.56.101",
      netmask: "255.255.255.0",
      auto_config: true,  # Auto-configure for reliability
      virtualbox__intnet: false  # Use host-only adapter, not internal network

    # Optional: Use host-only network for SSH instead of NAT
    # Uncomment to SSH via 192.168.56.101 instead of NAT
    # Note: This requires the host-only network to be configured first
    # kali.ssh.host = "192.168.56.101"
    # kali.ssh.port = 22

    # VirtualBox provider settings
    kali.vm.provider "virtualbox" do |vb|
      vb.name = "Kali_Exploit_Lab_#{random_suffix}"
      vb.memory = "3072"  # 3GB (increased for Metasploit upgrades)
      vb.cpus = 2
      vb.gui = false  # Headless (use SSH)

      # Performance optimizations
      vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
      vb.customize ["modifyvm", :id, "--natdnsproxy1", "on"]
      vb.customize ["modifyvm", :id, "--nictype1", "virtio"]
      vb.customize ["modifyvm", :id, "--nictype2", "virtio"]
    end

    # Shared folders - must be mounted for payload provisioning
    kali.vm.synced_folder "../exploits", "/vagrant/exploits",
      owner: "vagrant",
      group: "vagrant",
      mount_options: ["dmode=775,fmode=775"]

    kali.vm.synced_folder "../docs", "/vagrant/docs",
      mount_options: ["ro"]

    # Provisioning - Verify network is ready FIRST
    kali.vm.provision "shell",
      path: "provisioning/kali/verify_network_ready.sh",
      name: "Verify network is ready"

    # Provisioning - Configure network (fallback if auto-config fails)
    kali.vm.provision "shell",
      path: "provisioning/kali/configure_network_early.sh",
      name: "Configure host-only network (if needed)"

    # Provisioning - Install tools
    kali.vm.provision "shell",
      path: "provisioning/kali/install_tools.sh",
      name: "Install Metasploit and tools"

    # Provisioning - Generate HTA exploit (fake PDF)
    kali.vm.provision "shell",
      path: "provisioning/kali/create_hta_exploit.sh",
      privileged: false,  # Run as vagrant user
      name: "Generate HTA exploit (fake PDF)"

    # Provisioning - Setup HTTP server autostart
    kali.vm.provision "shell",
      path: "provisioning/kali/setup_http_autostart.sh",
      name: "Setup HTTP server autostart"

    # Provisioning - Start HTTP server manually for immediate use
    kali.vm.provision "shell",
      privileged: false,
      name: "Start HTTP server manually",
      inline: <<-SHELL
        echo "Starting HTTP server for immediate use..."
        cd /home/vagrant/hta_payloads
        nohup python3 -m http.server 8080 --bind 192.168.56.101 > /tmp/http_server.log 2>&1 &
        sleep 2
        if ss -tuln | grep -q ':8080 '; then
          echo "✓ HTTP server started successfully on port 8080"
        else
          echo "⚠ HTTP server will be available after VM restart"
        fi
      SHELL
  end

  # =========================================================================
  # WINDOWS SERVER 2008 R2 VM (Target)
  # =========================================================================

  config.vm.define "win2k8" do |win|
    win.vm.box = "rapid7/metasploitable3-win2k8"
    win.vm.hostname = "win-target"
    win.vm.communicator = "winrm"
    win.vm.boot_timeout = 600
    win.winrm.timeout = 1800  # 30 minutes for slow operations

    # Network - host-only network for VM-to-VM communication
    # NAT adapter is added automatically by Vagrant for WinRM management
    # Host-only adapter is for exploit traffic
    win.vm.network "private_network",
      ip: "192.168.56.102",
      netmask: "255.255.255.0",
      gateway: "192.168.56.1",
      auto_config: true,
      virtualbox__intnet: false  # Use host-only adapter, not internal network

    # VirtualBox provider settings
    win.vm.provider "virtualbox" do |vb|
      vb.name = "Windows_Exploit_Target_#{random_suffix}"
      vb.memory = "4096"
      vb.cpus = 2
      vb.gui = true  # GUI enabled (can be set to false for headless)

      # GUI optimizations
      vb.customize ["modifyvm", :id, "--vram", "128"]
      vb.customize ["modifyvm", :id, "--clipboard", "bidirectional"]
      vb.customize ["modifyvm", :id, "--draganddrop", "bidirectional"]

      # Performance
      vb.customize ["modifyvm", :id, "--nictype1", "82540EM"]
      vb.customize ["modifyvm", :id, "--nictype2", "82540EM"]
    end

    # Shared folders
    win.vm.synced_folder "../exploits", "/vagrant/exploits",
      owner: "vagrant",
      group: "vagrant"

    win.vm.synced_folder "../resources", "/vagrant/resources",
      owner: "vagrant",
      group: "vagrant"

    # Provisioning Step 1: Verify/Configure Host-Only network
    win.vm.provision "shell",
      path: "provisioning/windows/configure_hostonly_network.ps1",
      privileged: true,
      name: "Verify Host-Only network configuration"

    # Provisioning Step 2: Disable ALL security
    win.vm.provision "shell",
      path: "provisioning/windows/disable_security.ps1",
      privileged: true,
      name: "Disable Windows security features"

    # Provisioning Step 3: Install Adobe Reader (for PDF icon)
    win.vm.provision "shell",
      path: "provisioning/windows/install_adobe_reader.ps1",
      privileged: true,
      name: "Install Adobe Reader 9.0 (for PDF icon social engineering)"

    # Provisioning Step 4: Create desktop shortcuts
    win.vm.provision "shell",
      path: "provisioning/windows/create_shortcuts.ps1",
      privileged: true,
      name: "Create desktop shortcuts"

    # Provisioning Step 5: Test connectivity to Kali
    win.vm.provision "shell",
      path: "provisioning/windows/test_kali_connectivity.ps1",
      privileged: true,
      name: "Test network connectivity to Kali"

    # Final Step: Reboot to apply all settings
    win.vm.provision "shell",
      inline: "shutdown /r /t 30 /c 'Rebooting to apply all settings. VM will restart in 30 seconds.'",
      privileged: true,
      name: "Final reboot"
  end

end
