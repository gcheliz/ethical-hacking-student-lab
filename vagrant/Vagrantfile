# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|

  # =========================================================================
  # GLOBAL SETTINGS
  # =========================================================================

  config.vm.box_check_update = false
  config.vm.boot_timeout = 900  # 15 minutes for slower machines

  # Disable guest additions version check (intentionally using old vulnerable box)
  if Vagrant.has_plugin?("vagrant-vbguest")
    config.vbguest.auto_update = false
  end

  # Generate random suffix to prevent VM name conflicts
  random_suffix = rand(100000..999999)

  # =========================================================================
  # KALI LINUX VM (Attacker)
  # =========================================================================

  config.vm.define "kali" do |kali|
    kali.vm.box = "kalilinux/rolling"
    kali.vm.hostname = "kali-attacker"

    # SSH settings - Kali can be slow to boot
    kali.ssh.insert_key = true
    kali.ssh.forward_agent = false
    kali.ssh.connect_timeout = 600  # 10 minutes (increased for package upgrades)
    kali.ssh.keep_alive = true
    kali.vm.boot_timeout = 900  # 15 minutes for Kali

    # Network - Static IP on host-only network
    # Adapter 1: NAT (default, for internet access)
    # Adapter 2: Host-Only (192.168.56.0/24 for VM-to-VM communication)
    kali.vm.network "private_network",
      ip: "192.168.56.101",
      netmask: "255.255.255.0",
      auto_config: true,
      virtualbox__intnet: false,  # Use host-only adapter, not internal network
      adapter: 2

    # VirtualBox provider settings
    kali.vm.provider "virtualbox" do |vb|
      vb.name = "Kali_PDF_Exploit_Lab_#{random_suffix}"
      vb.memory = "3072"  # 3GB (increased for Metasploit upgrades)
      vb.cpus = 2
      vb.gui = false  # Headless (use SSH)

      # Performance optimizations
      vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
      vb.customize ["modifyvm", :id, "--natdnsproxy1", "on"]
      vb.customize ["modifyvm", :id, "--nictype1", "virtio"]
      vb.customize ["modifyvm", :id, "--nictype2", "virtio"]
    end

    # Shared folders - must be mounted for PDF provisioning
    kali.vm.synced_folder "../exploits", "/vagrant/exploits",
      owner: "vagrant",
      group: "vagrant",
      mount_options: ["dmode=775,fmode=775"]

    kali.vm.synced_folder "../docs", "/vagrant/docs",
      mount_options: ["ro"]

    # Provisioning - Install tools
    kali.vm.provision "shell",
      path: "provisioning/kali/install_tools.sh",
      name: "Install Metasploit and tools"

    # Provisioning - Fix network interface (ensure eth1 is up)
    kali.vm.provision "shell",
      path: "provisioning/kali/fix_network.sh",
      name: "Fix network interface eth1"

    # Provisioning - Configure network
    kali.vm.provision "shell",
      path: "provisioning/kali/configure_network.sh",
      name: "Configure static IP"

    # Provisioning - Generate exploit PDFs
    kali.vm.provision "shell",
      path: "provisioning/kali/create_exploits.sh",
      privileged: false,  # Run as vagrant user
      name: "Generate malicious PDFs"

    # Provisioning - Setup automatic HTTP server
    kali.vm.provision "shell",
      path: "provisioning/kali/setup_autostart.sh",
      name: "Setup automatic PDF HTTP server"
  end

  # =========================================================================
  # WINDOWS SERVER 2008 R2 VM (Target)
  # =========================================================================

  config.vm.define "win2k8" do |win|
    win.vm.box = "rapid7/metasploitable3-win2k8"
    win.vm.hostname = "win-target"
    win.vm.communicator = "winrm"
    win.vm.boot_timeout = 600
    win.winrm.timeout = 1800  # 30 minutes for slow operations

    # Network - Static IP on host-only network
    # Adapter 1: NAT (default, for internet access)
    # Adapter 2: Host-Only (192.168.56.0/24 for VM-to-VM communication)
    win.vm.network "private_network",
      ip: "192.168.56.102",
      netmask: "255.255.255.0",
      auto_config: true,
      virtualbox__intnet: false,  # Use host-only adapter, not internal network
      adapter: 2

    # VirtualBox provider settings
    win.vm.provider "virtualbox" do |vb|
      vb.name = "Windows_PDF_Target_Lab_#{random_suffix}"
      vb.memory = "4096"
      vb.cpus = 2
      vb.gui = true  # Need GUI for Adobe Reader

      # GUI optimizations
      vb.customize ["modifyvm", :id, "--vram", "128"]
      vb.customize ["modifyvm", :id, "--clipboard", "bidirectional"]
      vb.customize ["modifyvm", :id, "--draganddrop", "bidirectional"]

      # Performance
      vb.customize ["modifyvm", :id, "--nictype1", "82540EM"]
      vb.customize ["modifyvm", :id, "--nictype2", "82540EM"]
    end

    # Shared folder for Windows to access PDFs from Kali
    win.vm.synced_folder "../exploits", "/vagrant/exploits",
      owner: "vagrant",
      group: "vagrant"

    # Copy Adobe Reader installer to VM
    win.vm.provision "file",
      source: "../resources/AdobeReader_9.5.exe",
      destination: "C:\\AdobeReader_9.5.exe"

    # Provisioning Step 1: Disable ALL security
    win.vm.provision "shell",
      path: "provisioning/windows/disable_security.ps1",
      name: "Disable Windows security features"

    # Provisioning Step 2: Install Adobe Reader
    win.vm.provision "shell",
      path: "provisioning/windows/install_adobe.ps1",
      name: "Install and configure Adobe Reader 9.5.0"

    # Provisioning Step 3: Configure network
    win.vm.provision "shell",
      path: "provisioning/windows/configure_network.ps1",
      name: "Configure static IP address"

    # Provisioning Step 4: Create desktop shortcuts
    win.vm.provision "shell",
      path: "provisioning/windows/create_shortcuts.ps1",
      name: "Create desktop shortcuts"

    # Provisioning Step 5: Copy PDFs to Desktop (EASY MODE)
    win.vm.provision "shell",
      path: "provisioning/windows/copy_pdfs_to_desktop.ps1",
      name: "Copy malicious PDFs to Desktop"

    # Final Step: Reboot to apply all settings
    win.vm.provision "shell",
      inline: "shutdown /r /t 30 /c 'Rebooting to apply all settings. VM will restart in 30 seconds.'",
      name: "Final reboot"
  end

end
